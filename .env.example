# URL du webhook N8N qui reçoit les soumissions des formulaires (accueil + /contact)
# ET la capture de contact du chatbot — un seul workflow N8N, qui distingue les
# deux sources via le champ "source" du payload ("contact" / "chatbot"). Pas un
# secret sensible (contrairement à MISTRAL_API_KEY ci-dessous), donc volontairement
# public (NEXT_PUBLIC_) : simplicité assumée, une URL de webhook seule ne permet
# rien de plus qu'un spam potentiel, déjà limité par le rate limiting.
# Ne jamais committer la vraie valeur — voir .env.local (ignoré par git).
NEXT_PUBLIC_N8N_WEBHOOK_URL=

# --- Chatbot RAG (Mistral) ---
# Clé API Mistral (console.mistral.ai). Serveur uniquement, jamais NEXT_PUBLIC_*
# — tous les appels passent par app/api/chat/route.ts, jamais depuis le widget.
MISTRAL_API_KEY=

# Non utilisé actuellement — décommenter si Turnstile est réactivé plus tard.
# Protection anti-bot du chatbot désormais assurée par le rate limiting
# (session/IP/global, voir lib/chatbot/rate-limit.ts) et le filtre anti
# prompt-injection (lib/chatbot/prompt-injection.ts).
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
