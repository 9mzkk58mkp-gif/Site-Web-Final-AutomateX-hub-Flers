# URL du webhook N8N qui reçoit les soumissions du formulaire de contact ET la
# capture de contact du chatbot — un seul workflow N8N, qui distingue les deux
# origines via le champ "source" du payload ("contact" / "chatbot").
#
# SERVEUR UNIQUEMENT : ne jamais préfixer NEXT_PUBLIC_. Préfixée, la valeur
# serait inscrite en clair dans le JavaScript envoyé au navigateur, et n'importe
# qui pourrait poster sur le webhook en contournant la validation, le champ
# piège et le rate limiting. Le formulaire passe par /api/contact, le chatbot
# par /api/chat — aucun des deux n'a besoin de l'URL côté client.
# Ne jamais committer la vraie valeur — voir .env.local (ignoré par git).
N8N_WEBHOOK_URL=

# --- Chatbot RAG (Mistral) ---
# Clé API Mistral (console.mistral.ai). Serveur uniquement, jamais NEXT_PUBLIC_*
# — tous les appels passent par app/api/chat/route.ts, jamais depuis le widget.
MISTRAL_API_KEY=

# Non utilisé actuellement — décommenter si Turnstile est réactivé plus tard.
# Protection anti-bot du chatbot désormais assurée par le rate limiting
# (session/IP/global, voir lib/chatbot/rate-limit.ts) et le filtre anti
# prompt-injection (lib/chatbot/prompt-injection.ts).
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
