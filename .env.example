# URL du webhook N8N qui reçoit les soumissions des formulaires (accueil + /contact).
# Ne jamais committer la vraie valeur — voir .env.local (ignoré par git).
NEXT_PUBLIC_N8N_WEBHOOK_URL=

# --- Chatbot RAG (Mistral) ---
# Clé API Mistral (console.mistral.ai). Serveur uniquement, jamais NEXT_PUBLIC_*
# — tous les appels passent par app/api/chat/route.ts, jamais depuis le widget.
MISTRAL_API_KEY=

# URL du webhook N8N dédié à la capture de contact du chatbot. Séparée de
# NEXT_PUBLIC_N8N_WEBHOOK_URL (formulaire de contact classique) pour pouvoir
# router/monitorer les leads chatbot indépendamment côté N8N. Appelée
# uniquement côté serveur.
N8N_CHATBOT_WEBHOOK_URL=

# Cloudflare Turnstile (CAPTCHA invisible avant le premier message du chat) —
# dashboard.cloudflare.com, section Turnstile. Clé secrète : serveur uniquement.
TURNSTILE_SECRET_KEY=

# Cloudflare Turnstile — clé de site, publique par nature (visible dans le
# widget client), utilisée pour charger le challenge invisible.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
